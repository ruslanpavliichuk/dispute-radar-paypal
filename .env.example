# PayPal sandbox app (Disputes + Transaction search features enabled)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering the webhook (see README: "Testing the webhook locally")
PAYPAL_WEBHOOK_ID=
# Serve /docs and /openapi.json (off by default: they are public through the dev tunnel)
ENABLE_DOCS=false

# LLM used by ml/llm.py (weak labels, synthetic messages, drafts). Pick one provider and fill its key:
#   gemini (free tier at aistudio.google.com)  -> GEMINI_API_KEY
#   claude                                     -> ANTHROPIC_API_KEY
#   openai (any OpenAI-compatible API, e.g. xAI Grok)
#                                              -> LLM_API_KEY, LLM_BASE_URL (https://api.x.ai/v1) and LLM_MODEL
# LLM_MODEL blank = the provider's default (required for openai)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
RESEND_API_KEY=
KAGGLE_API_KEY=
KAGGLE_USERNAME=
# Local Postgres from `make db` (docker-compose.yml); throwaway dev credentials
DATABASE_URL=postgresql+psycopg://dispute:dispute@localhost:5432/dispute_radar
# Guards /api/proposals (approve/reject). Blank = those routes answer 503.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=
