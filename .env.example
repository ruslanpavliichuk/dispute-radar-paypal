# PayPal sandbox app (Disputes + Transaction search features enabled)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering the webhook (see README: "Testing the webhook locally")
PAYPAL_WEBHOOK_ID=
# Serve /docs and /openapi.json (off by default: they are public through the dev tunnel)
ENABLE_DOCS=false

ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
RESEND_API_KEY=
# Local Postgres from `make db` (docker-compose.yml); throwaway dev credentials
DATABASE_URL=postgresql+psycopg://dispute:dispute@localhost:5432/dispute_radar
